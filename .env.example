# Aiven Cloud MySQL (Live Free Cloud DB)
DB_URL=jdbc:mysql://quikquote-quotation-001.a.aivencloud.com:27777/defaultdb?sslmode=REQUIRED&allowPublicKeyRetrieval=true
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

